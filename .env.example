# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (for confirmation emails and NPS notifications)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=SignupSmartly <noreply@yourdomain.com>
# Recipient for production error alert emails (also used by NPS)
ADMIN_EMAIL=your-email@example.com

# App URL (for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta (Facebook) — pixel is public; CAPI token is server-only (never NEXT_PUBLIC_)
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
